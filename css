*{
  box-sizing:border-box;
}
body{
  background-color: #f2f2f2;
  margin:40px; 
  font-family:Arial, sans-serif;
}
.box {
  background-color: white;
  width: 300px;
  padding: 20px;
  border: 3px solid #3498db;
  margin: 40px auto;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}
h1{
  margin-bottom:30px;
  text-align:center;
}
